diff --git a/assets/css/admin-plain.css b/assets/css/admin-plain.css
new file mode 100644
index 0000000..2dfc399
--- /dev/null
+++ b/assets/css/admin-plain.css
@@ -0,0 +1,235 @@
+/* ==========================================================================
+   IHUGURE — admin / disable_user.php
+   --------------------------------------------------------------------------
+   That page ships with no CSS framework and no classes, so this sheet styles
+   the bare elements directly. It is only linked from disable_user.php, which
+   keeps these element selectors from touching the Bootstrap-based pages.
+   ========================================================================== */
+
+:root {
+  --navy-950: #050f20;
+  --navy-900: #071428;
+  --navy-800: #0b1f46;
+  --blue:        #00a1de;
+  --blue-deep:   #0a6fb5;
+  --sun:         #fad201;
+  --leaf-bright: #1faa63;
+  --danger:      #e5484d;
+  --ink:   #0b1b3a;
+  --muted: #5a6a88;
+  --line:  #dfe7f6;
+  --tint:  #f6f9ff;
+  --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Roboto, Arial, sans-serif;
+  color-scheme: light;
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+
+::selection { background: var(--sun); color: var(--navy-900); }
+
+body {
+  max-width: 720px;
+  min-height: 100vh;
+  margin: 0 auto;
+  padding: clamp(28px, 6vw, 64px) 16px;
+  font-family: var(--font);
+  font-size: 1rem;
+  line-height: 1.5;
+  color: var(--ink);
+  background:
+    radial-gradient(900px 420px at 0% -10%, rgba(0, 161, 222, .15), transparent 60%),
+    radial-gradient(700px 380px at 100% 0%, rgba(250, 210, 1, .17), transparent 55%),
+    #f3f6fc;
+  -webkit-font-smoothing: antialiased;
+}
+
+/* flag-coloured ribbon pinned to the top edge */
+body::before {
+  content: "";
+  position: fixed;
+  top: 0; right: 0; left: 0;
+  height: 6px;
+  background: linear-gradient(90deg,
+    var(--blue) 0 38%, var(--sun) 38% 68%, var(--leaf-bright) 68% 100%);
+}
+
+/* --- headings ----------------------------------------------------------- */
+
+h2 {
+  position: relative;
+  margin: 0 0 1.5rem;
+  padding-bottom: .7rem;
+  font-size: clamp(1.6rem, 4vw, 2.1rem);
+  font-weight: 800;
+  letter-spacing: -.02em;
+}
+h2::after {
+  content: "";
+  position: absolute;
+  left: 0; bottom: 0;
+  width: 72px;
+  height: 4px;
+  border-radius: 4px;
+  background: linear-gradient(90deg, var(--blue), var(--sun));
+}
+
+h3 {
+  display: flex;
+  align-items: center;
+  gap: .9rem;
+  margin: 0 0 1rem;
+  font-size: .85rem;
+  font-weight: 800;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+h3::after {
+  content: "";
+  flex: 1;
+  height: 1px;
+  background: linear-gradient(90deg, var(--line), transparent);
+}
+
+hr {
+  height: 1px;
+  margin: 2.25rem 0 2rem;
+  border: 0;
+  background: transparent;
+}
+
+/* --- result messages (the page colours them with inline green / red) ---- */
+
+p { margin: 0 0 1rem; color: var(--muted); }
+
+p[style*="color:green"],
+p[style*="color:red"] {
+  padding: .9rem 1.2rem;
+  font-weight: 600;
+  border-radius: 14px;
+  box-shadow: 0 14px 34px -24px rgba(11, 27, 58, .5);
+}
+p[style*="color:green"] {
+  color: #0f5132 !important;
+  background: #e4f7ec;
+  border-left: 5px solid var(--leaf-bright);
+}
+p[style*="color:red"] {
+  color: #842029 !important;
+  background: #fdeaea;
+  border-left: 5px solid var(--danger);
+}
+
+/* --- forms -------------------------------------------------------------- */
+
+form {
+  margin: 0 0 1rem;
+  padding: 1.35rem;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  box-shadow: 0 18px 40px -28px rgba(11, 27, 58, .55);
+}
+
+label {
+  display: block;
+  margin-bottom: .45rem;
+  font-size: .78rem;
+  font-weight: 800;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+input[type="text"] {
+  width: 100%;
+  max-width: 22rem;
+  margin: 0 .5rem .5rem 0;
+  padding: .7rem .95rem;
+  font: inherit;
+  font-weight: 600;
+  color: var(--ink);
+  background: #fff;
+  border: 1px solid #cbd6ec;
+  border-radius: 12px;
+  transition: border-color .2s ease, box-shadow .2s ease;
+}
+input[type="text"]:focus {
+  outline: 0;
+  border-color: var(--blue);
+  box-shadow: 0 0 0 .25rem rgba(0, 161, 222, .18);
+}
+
+/* --- buttons ------------------------------------------------------------ */
+
+button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: .6rem 1.3rem;
+  font: inherit;
+  font-size: .92rem;
+  font-weight: 700;
+  line-height: 1.2;
+  color: #fff;
+  background: var(--blue-deep);
+  border: 1px solid var(--blue-deep);
+  border-radius: 999px;
+  cursor: pointer;
+  transition: transform .15s ease, box-shadow .2s ease, background-color .2s ease,
+              color .2s ease, border-color .2s ease;
+}
+button:hover {
+  transform: translateY(-1px);
+  box-shadow: 0 10px 20px -12px rgba(11, 27, 58, .6);
+}
+button:active { transform: translateY(0); box-shadow: none; }
+button:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
+
+button[name="disable_user"] {
+  background: var(--danger);
+  border-color: var(--danger);
+}
+button[name="disable_user"]:hover { background: #cf3a3f; border-color: #cf3a3f; }
+
+button[name="enable_user"] {
+  padding: .4rem 1rem;
+  font-size: .85rem;
+  color: #127a45;
+  background: transparent;
+  border-color: rgba(31, 170, 99, .55);
+}
+button[name="enable_user"]:hover {
+  color: #fff;
+  background: var(--leaf-bright);
+  border-color: var(--leaf-bright);
+}
+
+/* --- disabled-users table ----------------------------------------------- */
+
+table {
+  width: 100%;
+  border: 0;
+  border-collapse: collapse;
+}
+th, td {
+  padding: .8rem .5rem;
+  text-align: left;
+  border: 0;
+  border-bottom: 1px solid var(--line);
+}
+th {
+  font-size: .72rem;
+  font-weight: 800;
+  letter-spacing: .13em;
+  text-transform: uppercase;
+  color: var(--muted);
+  border-bottom: 2px solid var(--sun);
+}
+td { font-weight: 600; font-variant-numeric: tabular-nums; }
+td:last-child { width: 1%; text-align: right; white-space: nowrap; }
+tr:last-child td { border-bottom: 0; }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; }
+}
diff --git a/assets/css/admin.css b/assets/css/admin.css
new file mode 100644
index 0000000..af2bdf5
--- /dev/null
+++ b/assets/css/admin.css
@@ -0,0 +1,491 @@
+/* ==========================================================================
+   IHUGURE — admin pages
+   --------------------------------------------------------------------------
+   Plain CSS layered on top of Bootstrap 5.3.0 (loaded first) for:
+     games.php · game_detail.php · create_question.php · maintenance.php
+   Where Bootstrap exposes a CSS variable (buttons, pagination, tables,
+   list groups, badges) the variable is re-pointed rather than fought with
+   !important, so hover / active / disabled states stay consistent.
+   No markup or PHP is touched.
+   ========================================================================== */
+
+:root {
+  --navy-950: #050f20;
+  --navy-900: #071428;
+  --navy-800: #0b1f46;
+
+  --blue:        #00a1de;
+  --blue-deep:   #0a6fb5;
+  --sun:         #fad201;
+  --sun-deep:    #e6b800;
+  --leaf-bright: #1faa63;
+  --danger:      #e5484d;
+
+  --ink:   #0b1b3a;
+  --muted: #5a6a88;
+  --line:  #dfe7f6;
+  --tint:  #f6f9ff;
+
+  --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Roboto, Arial, sans-serif;
+  --ribbon: linear-gradient(90deg,
+    var(--blue) 0 38%, var(--sun) 38% 68%, var(--leaf-bright) 68% 100%);
+
+  color-scheme: light;
+}
+
+/* --------------------------------------------------------------------------
+   1. Page
+   -------------------------------------------------------------------------- */
+
+::selection { background: var(--sun); color: var(--navy-900); }
+
+body {
+  min-height: 100vh;
+  font-family: var(--font);
+  color: var(--ink);
+  background:
+    radial-gradient(900px 420px at 0% -10%,  rgba(0, 161, 222, .15), transparent 60%),
+    radial-gradient(700px 380px at 100% 0%,  rgba(250, 210, 1, .17), transparent 55%),
+    #f3f6fc;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+/* flag-coloured ribbon pinned to the top edge */
+body::before {
+  content: "";
+  position: fixed;
+  top: 0; right: 0; left: 0;
+  height: 6px;
+  background: var(--ribbon);
+  z-index: 1100;
+}
+
+/* --------------------------------------------------------------------------
+   2. Headings
+   -------------------------------------------------------------------------- */
+
+/* page titles */
+h1,
+h2.mb-4,
+h3.mb-4 {
+  position: relative;
+  padding-bottom: .7rem;
+  font-size: clamp(1.6rem, 4vw, 2.1rem);
+  font-weight: 800;
+  letter-spacing: -.02em;
+  color: var(--ink);
+}
+h1::after,
+h2.mb-4::after,
+h3.mb-4::after {
+  content: "";
+  position: absolute;
+  left: 0; bottom: 0;
+  width: 72px;
+  height: 4px;
+  border-radius: 4px;
+  background: linear-gradient(90deg, var(--blue), var(--sun));
+}
+
+/* section headings (game_detail: "Questions and Answers", "Game Logs") */
+h2:not(.mb-4) {
+  display: flex;
+  align-items: center;
+  gap: .9rem;
+  margin: 2.4rem 0 1rem;
+  font-size: .85rem;
+  font-weight: 800;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+h2:not(.mb-4)::after {
+  content: "";
+  flex: 1;
+  height: 1px;
+  background: linear-gradient(90deg, var(--line), transparent);
+}
+
+/* --------------------------------------------------------------------------
+   3. Buttons  (Bootstrap 5.3 button variables)
+   -------------------------------------------------------------------------- */
+
+.btn {
+  --bs-btn-padding-x: 1.3rem;
+  --bs-btn-padding-y: .55rem;
+  --bs-btn-font-weight: 700;
+  --bs-btn-border-radius: 999px;
+  letter-spacing: .02em;
+  transition: transform .15s ease, box-shadow .2s ease, background-color .2s ease,
+              color .2s ease, border-color .2s ease;
+}
+.btn-sm {
+  --bs-btn-padding-x: 1rem;
+  --bs-btn-padding-y: .35rem;
+  --bs-btn-border-radius: 999px;
+}
+.btn:hover {
+  transform: translateY(-1px);
+  box-shadow: 0 10px 20px -12px rgba(11, 27, 58, .6);
+}
+.btn:active { transform: translateY(0); box-shadow: none; }
+
+.btn-primary {
+  --bs-btn-color: #fff;
+  --bs-btn-bg: var(--blue-deep);
+  --bs-btn-border-color: var(--blue-deep);
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: #085c97;
+  --bs-btn-hover-border-color: #085c97;
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: #06507f;
+  --bs-btn-active-border-color: #06507f;
+  --bs-btn-focus-shadow-rgb: 0, 161, 222;
+  --bs-btn-disabled-bg: var(--blue-deep);
+  --bs-btn-disabled-border-color: var(--blue-deep);
+}
+.btn-outline-primary {
+  --bs-btn-color: var(--blue-deep);
+  --bs-btn-border-color: #9fd0ee;
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: var(--blue-deep);
+  --bs-btn-hover-border-color: var(--blue-deep);
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: #085c97;
+  --bs-btn-active-border-color: #085c97;
+  --bs-btn-focus-shadow-rgb: 0, 161, 222;
+}
+.btn-secondary {
+  --bs-btn-color: #fff;
+  --bs-btn-bg: var(--navy-800);
+  --bs-btn-border-color: var(--navy-800);
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: var(--navy-900);
+  --bs-btn-hover-border-color: var(--navy-900);
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: var(--navy-950);
+  --bs-btn-active-border-color: var(--navy-950);
+  --bs-btn-focus-shadow-rgb: 11, 31, 70;
+}
+.btn-outline-secondary {
+  --bs-btn-color: var(--muted);
+  --bs-btn-border-color: #c6d1e8;
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: var(--navy-800);
+  --bs-btn-hover-border-color: var(--navy-800);
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: var(--navy-900);
+  --bs-btn-active-border-color: var(--navy-900);
+  --bs-btn-focus-shadow-rgb: 11, 31, 70;
+}
+.btn-danger {
+  --bs-btn-color: #fff;
+  --bs-btn-bg: var(--danger);
+  --bs-btn-border-color: var(--danger);
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: #cf3a3f;
+  --bs-btn-hover-border-color: #cf3a3f;
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: #b82f34;
+  --bs-btn-active-border-color: #b82f34;
+  --bs-btn-focus-shadow-rgb: 229, 72, 77;
+}
+.btn-success {
+  --bs-btn-color: #fff;
+  --bs-btn-bg: var(--leaf-bright);
+  --bs-btn-border-color: var(--leaf-bright);
+  --bs-btn-hover-color: #fff;
+  --bs-btn-hover-bg: #179353;
+  --bs-btn-hover-border-color: #179353;
+  --bs-btn-active-color: #fff;
+  --bs-btn-active-bg: #127a45;
+  --bs-btn-active-border-color: #127a45;
+  --bs-btn-focus-shadow-rgb: 31, 170, 99;
+}
+
+/* --------------------------------------------------------------------------
+   4. Form controls
+   -------------------------------------------------------------------------- */
+
+.form-label {
+  margin-bottom: .45rem;
+  font-size: .78rem;
+  font-weight: 800;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.form-control,
+.form-select {
+  padding-top: .65rem;
+  padding-bottom: .65rem;
+  color: var(--ink);
+  background-color: #fff;
+  border: 1px solid #cbd6ec;
+  border-radius: 12px;
+  transition: border-color .2s ease, box-shadow .2s ease;
+}
+.form-control::placeholder { color: #8c99b3; }
+.form-control:focus,
+.form-select:focus {
+  color: var(--ink);
+  border-color: var(--blue);
+  box-shadow: 0 0 0 .25rem rgba(0, 161, 222, .18);
+}
+
+.input-group-text {
+  color: var(--ink);
+  font-weight: 600;
+  background: var(--tint);
+  border: 1px solid #cbd6ec;
+  border-radius: 12px;
+}
+input[type="radio"] {
+  width: 1.1rem;
+  height: 1.1rem;
+  accent-color: var(--blue-deep);
+}
+
+/* games.php filter bar */
+form.row {
+  margin-right: 0;
+  margin-left: 0;
+  padding: .75rem .5rem;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  box-shadow: 0 14px 34px -24px rgba(11, 27, 58, .5);
+}
+form.row .form-control { min-width: 15rem; }
+
+/* --------------------------------------------------------------------------
+   5. Cards  (create_question.php)
+   -------------------------------------------------------------------------- */
+
+.card {
+  background:
+    var(--ribbon) top left / 100% 5px no-repeat,
+    #fff;
+  border: 1px solid var(--line);
+  border-radius: 20px;
+}
+form.card { padding-top: 1.75rem !important; }
+
+/* --------------------------------------------------------------------------
+   6. Tables  (games.php)
+   -------------------------------------------------------------------------- */
+
+.table {
+  --bs-table-bg: #fff;
+  --bs-table-border-color: var(--line);
+  margin-bottom: 1.75rem;
+  border: 1px solid var(--line);
+  border-collapse: separate;
+  border-spacing: 0;
+  border-radius: 16px;
+  overflow: hidden;
+  box-shadow: 0 16px 36px -24px rgba(11, 27, 58, .55);
+}
+.table.table-hover { --bs-table-hover-bg: #eef7ff; }
+
+.table-bordered > :not(caption) > * { border-width: 0; }
+.table-bordered > :not(caption) > * > * {
+  padding: .9rem 1.1rem;
+  border-width: 0 0 1px 0;
+  vertical-align: middle;
+}
+.table > tbody > tr:last-child > * { border-bottom-width: 0; }
+
+.table > thead {
+  --bs-table-bg: var(--navy-900);
+  --bs-table-color: #fff;
+  --bs-table-border-color: var(--navy-900);
+}
+.table > thead > tr > th {
+  font-size: .72rem;
+  font-weight: 800;
+  letter-spacing: .13em;
+  text-transform: uppercase;
+  border-bottom: 0;
+}
+
+/* ID and amount read better as figures; status reads better as a label */
+.table > tbody > tr > td:nth-child(1),
+.table > tbody > tr > td:nth-child(4) { font-variant-numeric: tabular-nums; }
+.table > tbody > tr > td:nth-child(3) { font-weight: 700; text-transform: capitalize; }
+
+/* --------------------------------------------------------------------------
+   7. Pagination  (Bootstrap 5.3 pagination variables)
+   -------------------------------------------------------------------------- */
+
+.pagination {
+  --bs-pagination-padding-x: .95rem;
+  --bs-pagination-padding-y: .5rem;
+  --bs-pagination-border-radius: 12px;
+  --bs-pagination-color: var(--blue-deep);
+  --bs-pagination-bg: #fff;
+  --bs-pagination-border-color: var(--line);
+  --bs-pagination-hover-color: #fff;
+  --bs-pagination-hover-bg: var(--blue-deep);
+  --bs-pagination-hover-border-color: var(--blue-deep);
+  --bs-pagination-focus-color: var(--blue-deep);
+  --bs-pagination-focus-bg: #fff;
+  --bs-pagination-focus-box-shadow: 0 0 0 .2rem rgba(0, 161, 222, .25);
+  --bs-pagination-active-color: var(--sun);
+  --bs-pagination-active-bg: var(--navy-900);
+  --bs-pagination-active-border-color: var(--navy-900);
+  --bs-pagination-disabled-color: #9aa8c4;
+  --bs-pagination-disabled-bg: #f1f4fa;
+  --bs-pagination-disabled-border-color: var(--line);
+  gap: .35rem;
+  flex-wrap: wrap;
+}
+.pagination .page-link {
+  font-weight: 700;
+  border-radius: var(--bs-pagination-border-radius);
+  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
+}
+.pagination .page-item:not(:first-child) .page-link { margin-left: 0; }
+
+/* --------------------------------------------------------------------------
+   8. Game detail  (game_detail.php)
+   -------------------------------------------------------------------------- */
+
+/* the "who / paid / how much" summary block */
+.container > .mb-3 {
+  padding: 1.1rem 1.4rem;
+  line-height: 2;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-left: 5px solid var(--blue);
+  border-radius: 14px;
+  box-shadow: 0 14px 34px -24px rgba(11, 27, 58, .5);
+}
+.container > .mb-3 strong {
+  display: inline-block;
+  min-width: 9.5rem;
+  font-weight: 700;
+  color: var(--muted);
+}
+
+/* numbered question headings: 1, 2, 3 … */
+.container { counter-reset: q; }
+div.mb-4 > h5 {
+  display: flex;
+  align-items: flex-start;
+  gap: .75rem;
+  margin-bottom: .85rem;
+  font-size: 1.05rem;
+  font-weight: 700;
+  line-height: 1.4;
+  color: var(--ink);
+}
+div.mb-4 > h5::before {
+  counter-increment: q;
+  content: counter(q);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: 0 0 auto;
+  min-width: 1.9rem;
+  height: 1.9rem;
+  padding: 0 .45rem;
+  border-radius: 999px;
+  font-size: .8rem;
+  font-weight: 800;
+  color: var(--sun);
+  background: var(--navy-900);
+}
+
+.list-group {
+  --bs-list-group-border-color: var(--line);
+  --bs-list-group-border-radius: 14px;
+  overflow: hidden;
+  box-shadow: 0 14px 34px -26px rgba(11, 27, 58, .55);
+}
+.list-group-item {
+  padding: .85rem 1.2rem;
+  font-weight: 500;
+}
+.list-group-item strong { color: var(--blue-deep); letter-spacing: .02em; }
+
+.list-group-item-success {
+  --bs-list-group-color: #0f5132;
+  --bs-list-group-bg: #e4f7ec;
+  --bs-list-group-border-color: #bfe8d1;
+  box-shadow: inset 4px 0 0 var(--leaf-bright);
+  font-weight: 600;
+}
+.list-group-item-danger {
+  --bs-list-group-color: #842029;
+  --bs-list-group-bg: #fdeaea;
+  --bs-list-group-border-color: #f5c2c7;
+  box-shadow: inset 4px 0 0 var(--danger);
+  font-weight: 600;
+}
+
+.badge {
+  padding: .45em .8em;
+  font-size: .68rem;
+  font-weight: 800;
+  letter-spacing: .06em;
+  text-transform: uppercase;
+  border-radius: 999px;
+}
+.badge.bg-success { --bs-success-rgb: 31, 170, 99; }
+.badge.bg-primary { --bs-primary-rgb: 10, 111, 181; }
+
+/* --------------------------------------------------------------------------
+   9. Alerts  (create_question.php prints one above the page on success)
+   -------------------------------------------------------------------------- */
+
+.alert {
+  border: 0;
+  border-radius: 14px;
+  font-weight: 600;
+  box-shadow: 0 14px 34px -24px rgba(11, 27, 58, .5);
+}
+.alert-success {
+  --bs-alert-color: #0f5132;
+  --bs-alert-bg: #e4f7ec;
+  border-left: 5px solid var(--leaf-bright);
+}
+body > .alert {
+  max-width: 720px;
+  margin: 1.5rem auto 0;
+}
+
+/* --------------------------------------------------------------------------
+   10. Maintenance switch  (maintenance.php — <body class="container">)
+   -------------------------------------------------------------------------- */
+
+body.container > form.d-flex {
+  flex-wrap: wrap;
+  padding: 1.5rem;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  box-shadow: 0 20px 44px -28px rgba(11, 27, 58, .55);
+}
+body.container > form.d-flex .btn {
+  flex: 1 1 14rem;
+  padding: 1rem 1.25rem;
+}
+
+/* --------------------------------------------------------------------------
+   11. Focus, motion, small screens
+   -------------------------------------------------------------------------- */
+
+a:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; animation: none !important; }
+}
+
+@media (max-width: 640px) {
+  .table { display: block; overflow-x: auto; white-space: nowrap; }
+  form.row .form-control { min-width: 0; }
+  .container > .mb-3 strong { min-width: 0; margin-right: .4rem; }
+}
diff --git a/assets/css/ihugure.css b/assets/css/ihugure.css
new file mode 100644
index 0000000..a626dc6
--- /dev/null
+++ b/assets/css/ihugure.css
@@ -0,0 +1,502 @@
+/* ==========================================================================
+   IHUGURE APP — player interface
+   --------------------------------------------------------------------------
+   Plain CSS layered on top of Bootstrap 4.6.2 (which is loaded first).
+   No markup, JavaScript or game logic is touched: every rule below targets
+   classes / elements that services/ui.php already prints.
+
+   Palette is a nod to the Rwandan flag: sky blue, sun yellow, leaf green,
+   set on a deep night-blue "game show" stage.
+   ========================================================================== */
+
+:root {
+  --navy-950: #050f20;
+  --navy-900: #071428;
+  --navy-800: #0b1f46;
+
+  --blue:       #00a1de;
+  --blue-deep:  #0a6fb5;
+  --sun:        #fad201;
+  --sun-deep:   #e6b800;
+  --leaf:       #20603d;
+  --leaf-bright:#1faa63;
+  --danger:     #e5484d;
+
+  --ink:    #0b1b3a;
+  --body:   #34456a;
+  --line:   #dfe7f6;
+  --tint:   #f6f9ff;
+
+  --radius-lg: 22px;
+  --radius-md: 16px;
+
+  --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Roboto, Arial, sans-serif;
+
+  --shadow-card:
+    0 40px 70px -28px rgba(2, 10, 30, .75),
+    0 10px 24px -10px rgba(2, 10, 30, .45);
+}
+
+/* --------------------------------------------------------------------------
+   1. Stage
+   -------------------------------------------------------------------------- */
+
+::selection { background: var(--sun); color: var(--navy-900); }
+
+body {
+  min-height: 100vh;
+  margin: 0;
+  padding: clamp(14px, 4vw, 44px) 0;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  font-family: var(--font);
+  font-size: 1rem;
+  line-height: 1.5;
+  color: #e8efff;
+  background:
+    radial-gradient(1100px 560px at 8% -8%,  rgba(0, 161, 222, .38), transparent 62%),
+    radial-gradient(900px 520px  at 108% 4%, rgba(250, 210, 1, .20), transparent 58%),
+    radial-gradient(900px 640px  at 50% 118%, rgba(31, 170, 99, .30), transparent 62%),
+    linear-gradient(165deg, var(--navy-950) 0%, var(--navy-800) 58%, #0a2f45 100%);
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  text-rendering: optimizeLegibility;
+}
+
+/* faint dot grid over the stage */
+body::before {
+  content: "";
+  position: fixed;
+  top: 0; right: 0; bottom: 0; left: 0;
+  z-index: 0;
+  pointer-events: none;
+  background-image: radial-gradient(rgba(255, 255, 255, .075) 1px, transparent 1px);
+  background-size: 24px 24px;
+}
+
+.container {
+  position: relative;
+  z-index: 1;
+  width: 100%;
+  max-width: 680px;
+}
+
+/* Messages the app writes straight into <body> (e.g. "Unsupported browser") */
+body > h1:not(#countdown),
+body > p {
+  position: relative;
+  z-index: 1;
+  padding: 0 1.5rem;
+  text-align: center;
+  color: #fff;
+}
+
+/* --------------------------------------------------------------------------
+   2. The card
+   -------------------------------------------------------------------------- */
+
+.card {
+  border: 0;
+  border-radius: var(--radius-lg);
+  background: #fff;
+  color: var(--ink);
+  box-shadow: var(--shadow-card);
+  overflow: hidden;
+  animation: card-rise .35s cubic-bezier(.2, .8, .2, 1) backwards;
+}
+
+/* tri-colour ribbon across the top */
+.card::before {
+  content: "";
+  display: block;
+  flex: 0 0 6px;
+  height: 6px;
+  background: linear-gradient(90deg,
+    var(--blue) 0 38%, var(--sun) 38% 68%, var(--leaf-bright) 68% 100%);
+}
+
+.card-header {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: .75rem;
+  padding: 1.05rem 1.25rem;
+  border: 0;
+  background: linear-gradient(135deg, var(--navy-900), var(--navy-800));
+  color: #fff;
+  font-size: .95rem;
+  font-weight: 800;
+  letter-spacing: .32em;
+  text-transform: uppercase;
+}
+
+/* a little gold "?" coin before the brand name */
+.card-header::before {
+  content: "?";
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: 0 0 auto;
+  width: 1.9rem;
+  height: 1.9rem;
+  border-radius: 50%;
+  background: radial-gradient(circle at 30% 25%, #fff3a0, var(--sun) 55%, var(--sun-deep));
+  color: var(--navy-900);
+  font-size: 1.1rem;
+  font-weight: 900;
+  letter-spacing: 0;
+  box-shadow: 0 0 0 4px rgba(250, 210, 1, .18), 0 4px 14px rgba(250, 210, 1, .45);
+}
+
+.card-body {
+  padding: clamp(1.25rem, 4.5vw, 2.25rem);
+}
+
+/* --------------------------------------------------------------------------
+   3. Typography inside the card
+   -------------------------------------------------------------------------- */
+
+.card-body h1 {
+  margin: 0 0 1rem;
+  font-size: clamp(1.3rem, 4.6vw, 1.75rem);
+  font-weight: 800;
+  line-height: 1.25;
+  letter-spacing: -.01em;
+  color: var(--ink);
+}
+
+.card-body p {
+  margin: 0 0 1.15rem;
+  font-size: 1.02rem;
+  font-weight: 400;
+  line-height: 1.75;
+  color: var(--body);
+}
+
+.card-body a {
+  color: var(--blue-deep);
+  font-weight: 600;
+  text-decoration: underline;
+  text-decoration-color: rgba(10, 111, 181, .35);
+  text-underline-offset: 3px;
+  transition: color .2s ease, text-decoration-color .2s ease;
+}
+.card-body a:hover {
+  color: var(--navy-800);
+  text-decoration-color: var(--sun-deep);
+}
+
+/* --------------------------------------------------------------------------
+   4. Forms
+   The question / prompt is a bare text node at the top of the <form>,
+   so the form itself carries the "question" typography.
+   -------------------------------------------------------------------------- */
+
+.card-body form {
+  margin: 0;
+  font-size: 1.2rem;
+  font-weight: 700;
+  line-height: 1.45;
+  color: var(--ink);
+}
+
+/* contain the floated "FUNGA" button */
+.card-body form::after {
+  content: "";
+  display: table;
+  clear: both;
+}
+
+/* the <br> after the prompt only adds an empty line */
+.card-body form > br { display: none; }
+
+.card-body form > .form-group:first-of-type { margin-top: 1.1rem; }
+
+/* text input (phone number screen) */
+.card-body .form-control {
+  height: auto;
+  padding: .95rem 1.1rem;
+  font-size: 1.2rem;
+  font-weight: 600;
+  letter-spacing: .04em;
+  color: var(--ink);
+  background: var(--tint);
+  border: 2px solid var(--line);
+  border-radius: var(--radius-md);
+  transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
+}
+.card-body .form-control:focus {
+  background: #fff;
+  border-color: var(--blue);
+  box-shadow: 0 0 0 4px rgba(0, 161, 222, .2);
+  outline: 0;
+}
+
+/* Fallback radio colour for browsers that skip the tile treatment below */
+.card-body input[type="radio"] { accent-color: var(--blue-deep); }
+
+/* --------------------------------------------------------------------------
+   5. Answer tiles
+   Each .form-group that holds a radio becomes one big tappable tile.
+   The real radio is stretched invisibly over the whole tile (so a tap
+   anywhere selects it, and keyboard / screen-reader behaviour is untouched)
+   and a drawn "coin" takes its place visually.
+   Wrapped in @supports so older browsers simply keep the plain layout.
+   -------------------------------------------------------------------------- */
+
+@supports selector(:has(*)) {
+
+  .card-body .form-group:has(> input[type="radio"]) {
+    position: relative;
+    display: flex;
+    align-items: center;
+    gap: .8rem;
+    margin-bottom: .7rem;
+    padding: .95rem 1.1rem;
+    font-size: 1.05rem;
+    font-weight: 600;
+    font-variant-numeric: tabular-nums; /* keeps "1)" "2)" "3)" the same width so answers line up */
+    line-height: 1.4;
+    color: var(--ink);
+    background: var(--tint);
+    border: 2px solid var(--line);
+    border-radius: var(--radius-md);
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+    transition: border-color .18s ease, background-color .18s ease,
+                box-shadow .18s ease, transform .18s ease;
+    animation: tile-rise .3s ease backwards;
+  }
+
+  .card-body .form-group:has(> input[type="radio"]) > input[type="radio"] {
+    position: absolute;
+    top: 0; left: 0;
+    width: 100%;
+    height: 100%;
+    margin: 0;
+    opacity: 0;
+    cursor: pointer;
+    z-index: 1;
+  }
+
+  /* the drawn radio "coin" */
+  .card-body .form-group:has(> input[type="radio"])::before {
+    content: "";
+    flex: 0 0 auto;
+    width: 1.5rem;
+    height: 1.5rem;
+    border-radius: 50%;
+    background: #fff;
+    border: 2px solid #b6c3de;
+    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
+  }
+
+  @media (hover: hover) {
+    .card-body .form-group:has(> input[type="radio"]):hover {
+      background: #fff;
+      border-color: var(--blue);
+      box-shadow: 0 12px 24px -14px rgba(0, 110, 200, .6);
+      transform: translateY(-2px);
+    }
+    .card-body .form-group:has(> input[type="radio"]):hover::before {
+      border-color: var(--blue);
+    }
+  }
+
+  .card-body .form-group:has(> input[type="radio"]):active {
+    transform: scale(.99);
+  }
+
+  .card-body .form-group:has(> input[type="radio"]:checked) {
+    background: linear-gradient(180deg, #fffdea, #fff4b0);
+    border-color: var(--sun);
+    box-shadow: 0 0 0 4px rgba(250, 210, 1, .32), 0 14px 26px -16px rgba(230, 184, 0, .9);
+  }
+
+  .card-body .form-group:has(> input[type="radio"]:checked)::before {
+    border-color: var(--sun-deep);
+    background: radial-gradient(circle at center,
+      var(--navy-900) 0 34%, var(--sun) 38% 100%);
+    box-shadow: 0 0 0 3px rgba(250, 210, 1, .35);
+  }
+
+  .card-body .form-group:has(> input[type="radio"]:focus-visible) {
+    outline: 3px solid var(--blue);
+    outline-offset: 3px;
+  }
+}
+
+/* --------------------------------------------------------------------------
+   6. Buttons
+   IBIKURIKIRA (.btn-primary) = go on  → warm gold, the obvious action
+   FUNGA       (.btn-danger)  = quit   → quiet red outline, hard to hit by accident
+   Every state sets colour + background + border so Bootstrap's blue/red
+   hover & active colours never leak through.
+   -------------------------------------------------------------------------- */
+
+.card-body .btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  vertical-align: top;
+  min-height: 3rem;
+  margin-top: .35rem;
+  padding: .7rem 1.7rem;
+  font-size: .9rem;
+  font-weight: 800;
+  line-height: 1.2;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+  border-width: 2px;
+  border-radius: 999px;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform .15s ease, box-shadow .2s ease, background .2s ease,
+              color .2s ease, border-color .2s ease;
+}
+
+/* --- primary ------------------------------------------------------------ */
+.card-body .btn-primary {
+  color: var(--navy-900);
+  background: linear-gradient(180deg, #ffe45c 0%, var(--sun) 55%, #f2c500 100%);
+  border-color: #e0b600;
+  box-shadow: 0 12px 24px -12px rgba(230, 184, 0, .95), inset 0 1px 0 rgba(255, 255, 255, .75);
+}
+.card-body .btn-primary:hover {
+  color: var(--navy-900);
+  background: linear-gradient(180deg, #fff07f 0%, #ffdf2e 55%, #f7ca00 100%);
+  border-color: #e0b600;
+  box-shadow: 0 16px 28px -12px rgba(230, 184, 0, 1), inset 0 1px 0 rgba(255, 255, 255, .85);
+  transform: translateY(-2px);
+}
+.card-body .btn-primary:focus,
+.card-body .btn-primary.focus {
+  color: var(--navy-900);
+  background: linear-gradient(180deg, #ffe45c 0%, var(--sun) 55%, #f2c500 100%);
+  border-color: #e0b600;
+  box-shadow: 0 0 0 4px rgba(250, 210, 1, .5), 0 12px 24px -12px rgba(230, 184, 0, .95);
+  outline: 0;
+}
+.card-body .btn-primary:not(:disabled):not(.disabled):active,
+.card-body .btn-primary:not(:disabled):not(.disabled):active:focus {
+  color: var(--navy-900);
+  background: linear-gradient(180deg, #f2c500, var(--sun-deep));
+  border-color: #cfa400;
+  box-shadow: 0 0 0 4px rgba(250, 210, 1, .4), inset 0 2px 4px rgba(0, 0, 0, .18);
+  transform: translateY(1px);
+}
+
+/* --- danger (quit) ------------------------------------------------------ */
+.card-body .btn-danger {
+  color: #c2272d;
+  background: transparent;
+  border-color: rgba(229, 72, 77, .45);
+  box-shadow: none;
+}
+.card-body .btn-danger:hover {
+  color: #fff;
+  background: var(--danger);
+  border-color: var(--danger);
+  box-shadow: 0 14px 26px -12px rgba(229, 72, 77, .85);
+  transform: translateY(-2px);
+}
+.card-body .btn-danger:focus,
+.card-body .btn-danger.focus {
+  color: #c2272d;
+  background: transparent;
+  border-color: var(--danger);
+  box-shadow: 0 0 0 4px rgba(229, 72, 77, .25);
+  outline: 0;
+}
+.card-body .btn-danger:not(:disabled):not(.disabled):active,
+.card-body .btn-danger:not(:disabled):not(.disabled):active:focus {
+  color: #fff;
+  background: #c9383d;
+  border-color: #c9383d;
+  box-shadow: 0 0 0 4px rgba(229, 72, 77, .25);
+  transform: translateY(1px);
+}
+
+/* --------------------------------------------------------------------------
+   7. Countdown
+   The app prints a bare <h1 id="countdown" style="position:fixed; ...">.
+   Inline styles can only be beaten with !important, so the few properties
+   it sets itself are re-declared here; everything else is ordinary CSS.
+   -------------------------------------------------------------------------- */
+
+#countdown {
+  right: 16px !important;
+  bottom: 16px !important;
+  padding: 0 !important;
+  font-size: clamp(1.9rem, 8vw, 2.6rem) !important;
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 5.2rem;
+  height: 5.2rem;
+  margin: 0;
+  border-radius: 50%;
+  font-family: var(--font);
+  font-weight: 900;
+  line-height: 1;
+  letter-spacing: 0;
+  font-variant-numeric: tabular-nums;
+  color: var(--navy-900);
+  background: radial-gradient(circle at 30% 25%, #fff3a0, var(--sun) 55%, var(--sun-deep));
+  box-shadow: 0 0 0 6px rgba(250, 210, 1, .22), 0 16px 34px -8px rgba(0, 0, 0, .65);
+  animation: tick 1s ease-in-out infinite;
+}
+
+/* nothing to show until the first tick */
+#countdown:empty { display: none; }
+
+/* --------------------------------------------------------------------------
+   8. Keyboard focus, motion, small screens
+   -------------------------------------------------------------------------- */
+
+a:focus-visible,
+button:focus-visible {
+  outline: 3px solid var(--blue);
+  outline-offset: 3px;
+}
+
+@keyframes card-rise {
+  from { opacity: 0; transform: translateY(16px) scale(.985); }
+  to   { opacity: 1; transform: none; }
+}
+@keyframes tile-rise {
+  from { opacity: 0; transform: translateY(8px); }
+  to   { opacity: 1; transform: none; }
+}
+@keyframes tick {
+  0%, 100% { transform: scale(1); }
+  50%      { transform: scale(1.07); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+@media (max-width: 420px) {
+  .card-header { letter-spacing: .22em; font-size: .85rem; }
+  .card-body .btn {
+    padding: .65rem 1.15rem;
+    font-size: .8rem;
+    letter-spacing: .05em;
+  }
+  #countdown { width: 4.4rem; height: 4.4rem; right: 12px !important; bottom: 12px !important; }
+}
+
+/* give long answers more room on narrow phones */
+@media (max-width: 420px) {
+  @supports selector(:has(*)) {
+    .card-body .form-group:has(> input[type="radio"]) {
+      gap: .65rem;
+      padding: .85rem .9rem;
+    }
+  }
+}
